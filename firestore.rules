rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Users collection and all subcollections (appData, mediaBlobs, etc.)
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
